<Project>
  <Import Project="..\Directory.Build.props" />
  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepositoryRoot>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(RepositoryRoot)artifacts\runtime-packages\</PackageOutputPath>
    <WebScenePackageVersion Condition="'$(WebScenePackageVersion)' == '' and '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</WebScenePackageVersion>
    <WebScenePackageVersion Condition="'$(WebScenePackageVersion)' == ''">$(VersionPrefix)</WebScenePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <_WebSceneManagedPackageProject Include="$(RepositoryRoot)src\WebScene.Core\WebScene.Core.csproj" />
    <_WebSceneManagedPackageProject Include="$(RepositoryRoot)src\WebScene.Backend.Abstractions\WebScene.Backend.Abstractions.csproj" />
    <_WebSceneManagedPackageProject Include="$(RepositoryRoot)src\WebScene.Css\WebScene.Css.csproj" />
    <_WebSceneManagedPackageProject Include="$(RepositoryRoot)src\WebScene.Dom\WebScene.Dom.csproj" />
    <_WebSceneManagedPackageProject Include="$(RepositoryRoot)src\WebScene.Graphics\WebScene.Graphics.csproj" />
    <_WebSceneManagedPackageProject Include="$(RepositoryRoot)src\WebScene.Backend.Avalonia\WebScene.Backend.Avalonia.csproj" />
  </ItemGroup>

  <Target Name="ValidateWebSceneRuntimeInputs">
    <Error Condition="'$(WebSceneNativeEngineRid)' == ''"
           Text="PackWebSceneRuntime requires WebSceneNativeEngineRid." />
    <Error Condition="'$(WebSceneNativeEnginePath)' == '' or !Exists('$(WebSceneNativeEnginePath)')"
           Text="PackWebSceneRuntime requires an existing WebSceneNativeEnginePath." />
  </Target>

  <Target Name="PackWebSceneRuntime" DependsOnTargets="ValidateWebSceneRuntimeInputs">
    <MakeDir Directories="$(PackageOutputPath)" />
    <MSBuild Projects="@(_WebSceneManagedPackageProject)"
             Targets="Rebuild;Pack"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);PackageOutputPath=$(PackageOutputPath);PackageVersion=$(WebScenePackageVersion)" />
    <MSBuild Projects="$(RepositoryRoot)packaging\WebScene.NativeEngine.Runtime\WebScene.NativeEngine.Runtime.csproj"
             Targets="Pack"
             Properties="Configuration=$(Configuration);PackageOutputPath=$(PackageOutputPath);PackageVersion=$(WebScenePackageVersion);WebSceneNativeEngineRid=$(WebSceneNativeEngineRid);WebSceneNativeEnginePath=$(WebSceneNativeEnginePath)" />
    <ItemGroup>
      <_WebSceneProductPackage Include="$(PackageOutputPath)*.$(WebScenePackageVersion).nupkg" />
    </ItemGroup>
    <Error Condition="'@(_WebSceneProductPackage->Count())' != '7'"
           Text="Expected 7 WebScene runtime packages at version $(WebScenePackageVersion), found @(_WebSceneProductPackage->Count())." />
    <GetFileHash Files="@(_WebSceneProductPackage)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WebSceneProductPackageHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(PackageOutputPath)packages.sha256"
                      Lines="@(_WebSceneProductPackageHash->'%(FileHash)  %(Filename)%(Extension)')"
                      Overwrite="true" />
    <WriteLinesToFile File="$(PackageOutputPath)webscene-runtime.json"
                      Lines="{&quot;schemaVersion&quot;:1,&quot;packageVersion&quot;:&quot;$(WebScenePackageVersion)&quot;,&quot;runtimeIdentifier&quot;:&quot;$(WebSceneNativeEngineRid)&quot;,&quot;configuration&quot;:&quot;$(Configuration)&quot;,&quot;packageCount&quot;:7,&quot;checksums&quot;:&quot;packages.sha256&quot;}"
                      Overwrite="true" />
    <Message Importance="high"
             Text="Packed generic WebScene runtime $(WebScenePackageVersion) for $(WebSceneNativeEngineRid) to $(PackageOutputPath)." />
  </Target>
</Project>
