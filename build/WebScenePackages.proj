<Project>
  <Import Project="..\Directory.Build.props" />

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildThisFileDirectory)..\artifacts\nuget-packages\</PackageOutputPath>
    <WebScenePackageVersion Condition="'$(WebScenePackageVersion)' == '' and '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</WebScenePackageVersion>
    <WebScenePackageVersion Condition="'$(WebScenePackageVersion)' == ''">$(VersionPrefix)</WebScenePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Core\WebScene.Core.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Backend.Abstractions\WebScene.Backend.Abstractions.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Css\WebScene.Css.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Dom\WebScene.Dom.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Graphics\WebScene.Graphics.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.JavaScript.Interop\WebScene.JavaScript.Interop.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Diagnostics.Cdp\WebScene.Diagnostics.Cdp.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Backend.Avalonia\WebScene.Backend.Avalonia.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Backend.Uno\WebScene.Backend.Uno.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene\WebScene.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Sdk\WebScene.Sdk.csproj" />
    <_WebScenePackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.Sdk.Avalonia\WebScene.Sdk.Avalonia.csproj" />
    <_WebSceneNoSymbolsPackageProject Include="$(MSBuildThisFileDirectory)..\src\WebScene.JavaScript.Interop.Generator\WebScene.JavaScript.Interop.Generator.csproj" />
    <_WebSceneExpectedPackageId Include="WebScene" />
    <_WebSceneExpectedPackageId Include="WebScene.Backend.Abstractions" />
    <_WebSceneExpectedPackageId Include="WebScene.Backend.Avalonia" />
    <_WebSceneExpectedPackageId Include="WebScene.Backend.Uno" />
    <_WebSceneExpectedPackageId Include="WebScene.Core" />
    <_WebSceneExpectedPackageId Include="WebScene.Css" />
    <_WebSceneExpectedPackageId Include="WebScene.Dom" />
    <_WebSceneExpectedPackageId Include="WebScene.Diagnostics.Cdp" />
    <_WebSceneExpectedPackageId Include="WebScene.Graphics" />
    <_WebSceneExpectedPackageId Include="WebScene.JavaScript.Interop" />
    <_WebSceneExpectedPackageId Include="WebScene.JavaScript.Interop.Generator" />
    <_WebSceneExpectedPackageId Include="WebScene.Sdk" />
    <_WebSceneExpectedPackageId Include="WebScene.Sdk.Avalonia" />
    <_WebSceneExpectedSymbolsPackageId Include="@(_WebSceneExpectedPackageId)"
                                     Exclude="WebScene.JavaScript.Interop.Generator" />
  </ItemGroup>

  <Target Name="PackPackages">
    <Error Condition="'$(WebScenePackageVersion)' == ''"
           Text="WebScenePackageVersion could not be resolved." />
    <MakeDir Directories="$(PackageOutputPath)" />
    <MSBuild Projects="@(_WebScenePackageProject);@(_WebSceneNoSymbolsPackageProject)"
             Targets="Restore"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);PackageVersion=$(WebScenePackageVersion);ContinuousIntegrationBuild=$(ContinuousIntegrationBuild)" />
    <MSBuild Projects="@(_WebScenePackageProject)"
             Targets="Pack"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);PackageOutputPath=$(PackageOutputPath);PackageVersion=$(WebScenePackageVersion);IncludeSymbols=true;SymbolPackageFormat=snupkg;ContinuousIntegrationBuild=$(ContinuousIntegrationBuild)" />
    <MSBuild Projects="@(_WebSceneNoSymbolsPackageProject)"
             Targets="Pack"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);PackageOutputPath=$(PackageOutputPath);PackageVersion=$(WebScenePackageVersion);IncludeSymbols=false;ContinuousIntegrationBuild=$(ContinuousIntegrationBuild)" />
    <ItemGroup>
      <_WebSceneMissingPackage
        Include="@(_WebSceneExpectedPackageId)"
        Condition="!Exists('$(PackageOutputPath)%(Identity).$(WebScenePackageVersion).nupkg')" />
      <_WebSceneMissingSymbolsPackage
        Include="@(_WebSceneExpectedSymbolsPackageId)"
        Condition="!Exists('$(PackageOutputPath)%(Identity).$(WebScenePackageVersion).snupkg')" />
    </ItemGroup>
    <Error Condition="'@(_WebSceneMissingPackage->Count())' != '0'"
           Text="Missing packages at version $(WebScenePackageVersion): @(_WebSceneMissingPackage)." />
    <Error Condition="'@(_WebSceneMissingSymbolsPackage->Count())' != '0'"
           Text="Missing symbol packages at version $(WebScenePackageVersion): @(_WebSceneMissingSymbolsPackage)." />
    <Message Importance="high"
             Text="Packed 13 WebScene packages at $(WebScenePackageVersion) to $(PackageOutputPath)." />
  </Target>
</Project>
