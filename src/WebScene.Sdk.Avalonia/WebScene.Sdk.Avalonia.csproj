<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <TrimMode>copyused</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>A reusable native Avalonia host for packaged WebScene components, lifecycle, capabilities, and diagnostics.</Description>
    <PackageId>WebScene.Sdk.Avalonia</PackageId>
    <AssemblyName>WebScene.Sdk.Avalonia</AssemblyName>
    <RootNamespace>WebScene.Sdk.Avalonia</RootNamespace>
    <PackageTags>html;dom;css;avalonia;components;host-bridge</PackageTags>
    <RepositoryUrl>https://github.com/wieslawsoltes/WebScene</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WebScene.Sdk\WebScene.Sdk.csproj" />
    <ProjectReference Include="..\WebScene.Backend.Avalonia\WebScene.Backend.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
