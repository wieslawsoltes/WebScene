<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <Description>Runtime-neutral, handle-based JavaScript interop contracts for generated WebScene bindings.</Description>
    <PackageId>WebScene.JavaScript.Interop</PackageId>
    <PackageTags>webscene;javascript;interop;source-generator</PackageTags>
    <RepositoryUrl>https://github.com/wieslawsoltes/WebScene</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
