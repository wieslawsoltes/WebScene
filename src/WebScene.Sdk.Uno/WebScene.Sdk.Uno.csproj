<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <TrimMode>copyused</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>A reusable native Uno Platform host for packaged WebScene components, lifecycle, capabilities, and diagnostics.</Description>
    <PackageId>WebScene.Sdk.Uno</PackageId>
    <AssemblyName>WebScene.Sdk.Uno</AssemblyName>
    <RootNamespace>WebScene.Sdk.Uno</RootNamespace>
    <PackageTags>html;dom;css;uno;components;host-bridge</PackageTags>
    <RepositoryUrl>https://github.com/wieslawsoltes/WebScene</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WebScene.Sdk\WebScene.Sdk.csproj" />
    <ProjectReference Include="..\WebScene.Backend.Uno\WebScene.Backend.Uno.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" VersionOverride="3.119.2" />
    <PackageReference Include="SkiaSharp.HarfBuzz" VersionOverride="3.119.2" />
    <PackageReference Include="Svg.Skia" VersionOverride="5.1.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\WebScene.Sdk.NativeHost.Shared\NativeComponentBridgeSession.cs" Link="NativeComponentBridgeSession.cs" />
    <Compile Include="..\WebScene.Sdk.NativeHost.Shared\NativeComponentHostBridge.cs" Link="NativeComponentHostBridge.cs" />
    <Compile Include="..\WebScene.Sdk.NativeHost.Shared\WebSceneComponentResourceLoader.cs" Link="WebSceneComponentResourceLoader.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
