<Project>
  <ItemGroup Condition="'$(HtmlMLInteropApiManifest)' != '' and '$(HtmlMLInteropPolicy)' != ''">
    <AdditionalFiles Remove="$(HtmlMLInteropApiManifest)" />
    <AdditionalFiles Remove="$(HtmlMLInteropPolicy)" />
    <AdditionalFiles Include="$(HtmlMLInteropApiManifest)" />
    <AdditionalFiles Include="$(HtmlMLInteropPolicy)" />
  </ItemGroup>

  <Target Name="ValidateHtmlMLJavaScriptInteropInputs"
          BeforeTargets="CoreCompile"
          Condition="'$(HtmlMLInteropApiManifest)' != '' or '$(HtmlMLInteropPolicy)' != ''">
    <Error Condition="'$(HtmlMLInteropApiManifest)' == ''"
           Text="HtmlMLInteropApiManifest must be set when HtmlMLInteropPolicy is configured." />
    <Error Condition="'$(HtmlMLInteropPolicy)' == ''"
           Text="HtmlMLInteropPolicy must be set when HtmlMLInteropApiManifest is configured." />
    <Error Condition="'$(HtmlMLInteropApiManifest)' != '' and !Exists('$(HtmlMLInteropApiManifest)')"
           Text="The HtmlML JavaScript interop API manifest does not exist: $(HtmlMLInteropApiManifest)" />
    <Error Condition="'$(HtmlMLInteropPolicy)' != '' and !Exists('$(HtmlMLInteropPolicy)')"
           Text="The HtmlML JavaScript interop policy does not exist: $(HtmlMLInteropPolicy)" />
  </Target>
</Project>
