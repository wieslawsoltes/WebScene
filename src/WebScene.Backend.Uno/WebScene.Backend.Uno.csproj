<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <Description>Supported Uno Platform Skia desktop presenter for WebScene's native scene runtime.</Description>
    <PackageId>WebScene.Backend.Uno</PackageId>
    <AssemblyName>WebScene.Backend.Uno</AssemblyName>
    <RootNamespace>WebScene.Backends.Uno</RootNamespace>
    <PackageTags>html;dom;css;canvas;svg;uno;skia;backend</PackageTags>
    <DefineConstants>$(DefineConstants);WEBSCENE_UNO</DefineConstants>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebScene.Core\WebScene.Core.csproj" />
    <ProjectReference Include="..\WebScene.Backend.Abstractions\WebScene.Backend.Abstractions.csproj" />
    <ProjectReference Include="..\WebScene.Css\WebScene.Css.csproj" />
    <ProjectReference Include="..\WebScene.JavaScript.Interop\WebScene.JavaScript.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Uno.WinUI" />
    <PackageReference Include="Uno.WinUI.Graphics2DSK" />
    <PackageReference Include="SkiaSharp" VersionOverride="3.119.2" />
    <PackageReference Include="SkiaSharp.HarfBuzz" VersionOverride="3.119.2" />
    <PackageReference Include="Svg.Skia" VersionOverride="5.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native scene reader and retained Skia renderer are shared with the
         reference backend; WEBSCENE_UNO removes only Avalonia's surface adapter. -->
    <Compile Include="..\WebScene.Backend.Avalonia\NativeCanvasSceneRenderer.cs" Link="NativeCanvasSceneRenderer.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeSceneComposition.cs" Link="NativeSceneComposition.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeSceneInteropTypes.cs" Link="NativeSceneInteropTypes.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeSceneRenderingTypes.cs" Link="NativeSceneRenderingTypes.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeSceneRuntime.cs" Link="NativeSceneRuntime.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeImageResource.cs" Link="NativeImageResource.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeRuntimeDiagnostics.cs" Link="NativeRuntimeDiagnostics.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeWebSceneView.Diagnostics.cs" Link="NativeWebSceneView.Diagnostics.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeTextShaping.cs" Link="NativeTextShaping.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeVariableFontInstancer.cs" Link="NativeVariableFontInstancer.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeTextRunPositioning.cs" Link="NativeTextRunPositioning.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\WindowsDirectWriteRunPositioner.cs" Link="WindowsDirectWriteRunPositioner.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeInteropCallbacks.cs" Link="NativeInteropCallbacks.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeInteropResult.cs" Link="NativeInteropResult.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeInteropTransport.cs" Link="NativeInteropTransport.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeInteropValues.cs" Link="NativeInteropValues.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeWebSceneRuntime.cs" Link="NativeWebSceneRuntime.cs" />
    <Compile Include="..\WebScene.Backend.Avalonia\NativeV8InspectorSession.cs" Link="NativeV8InspectorSession.cs" />
  </ItemGroup>
</Project>
