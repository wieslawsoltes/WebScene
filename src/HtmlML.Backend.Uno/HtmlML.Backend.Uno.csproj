<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <Description>The Uno Platform Skia backend for HtmlML.</Description>
    <PackageId>HtmlML.Backend.Uno</PackageId>
    <AssemblyName>HtmlML.Backend.Uno</AssemblyName>
    <RootNamespace>HtmlML.Backends.Uno</RootNamespace>
    <PackageTags>html;dom;css;canvas;svg;uno;skia;backend</PackageTags>
    <DefineConstants>$(DefineConstants);HTMLML_UNO</DefineConstants>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HtmlML.Core\HtmlML.Core.csproj" />
    <ProjectReference Include="..\HtmlML.Backend.Abstractions\HtmlML.Backend.Abstractions.csproj" />
    <ProjectReference Include="..\HtmlML.Css\HtmlML.Css.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Uno.WinUI" />
    <PackageReference Include="Uno.WinUI.Graphics2DSK" />
    <PackageReference Include="SkiaSharp" VersionOverride="3.119.2" />
    <PackageReference Include="SkiaSharp.HarfBuzz" VersionOverride="3.119.2" />
    <PackageReference Include="Svg.Skia" VersionOverride="5.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native scene reader and retained Skia renderer are shared with the
         reference backend; HTMLML_UNO removes only Avalonia's surface adapter. -->
    <Compile Include="..\HtmlML.Backend.Avalonia\NativeSceneRuntime.cs" Link="NativeSceneRuntime.cs" />
    <Compile Include="..\HtmlML.Backend.Avalonia\NativeHtmlMlRuntime.cs" Link="NativeHtmlMlRuntime.cs" />
  </ItemGroup>
</Project>
