<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <MonacoSourceDirectory>$(MSBuildProjectDirectory)\..\NativeMonacoEditor</MonacoSourceDirectory>
  </PropertyGroup>

  <Target Name="BuildNativeMonacoAssets"
          BeforeTargets="Build"
          Inputs="$(MonacoSourceDirectory)\web\editor-entry.js;$(MonacoSourceDirectory)\build-monaco.mjs;$(MonacoSourceDirectory)\package-lock.json"
          Outputs="$(MonacoSourceDirectory)\Assets\monaco.js;$(MonacoSourceDirectory)\Assets\monaco.css;$(MonacoSourceDirectory)\Assets\codicon.ttf">
    <Exec WorkingDirectory="$(MonacoSourceDirectory)"
          Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(MonacoSourceDirectory)"
          Command="npm run build:web" />
  </Target>
</Project>
