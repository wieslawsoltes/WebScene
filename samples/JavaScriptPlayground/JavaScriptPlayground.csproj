<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);WEBSCENE_CLEARSCRIPT_V8</DefineConstants>
    <WebSceneClearScriptNativeRequired>true</WebSceneClearScriptNativeRequired>
  </PropertyGroup>
  <PropertyGroup>
    <WebSceneClearScriptNativePath Condition="'$(WebSceneClearScriptNativePath)' == '' and '$(WEBSCENE_CLEARSCRIPT_NATIVE)' != ''">$(WEBSCENE_CLEARSCRIPT_NATIVE)</WebSceneClearScriptNativePath>
    <WebSceneClearScriptNativeRid Condition="'$(WebSceneClearScriptNativeRid)' == '' and '$(WEBSCENE_CLEARSCRIPT_RID)' != ''">$(WEBSCENE_CLEARSCRIPT_RID)</WebSceneClearScriptNativeRid>
    <WebSceneClearScriptNativeRid Condition="'$(WebSceneClearScriptNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</WebSceneClearScriptNativeRid>
    <WebSceneClearScriptNativeFileName Condition="$([System.String]::Copy('$(WebSceneClearScriptNativeRid)').StartsWith('win-'))">ClearScriptV8.$(WebSceneClearScriptNativeRid).dll</WebSceneClearScriptNativeFileName>
    <WebSceneClearScriptNativeFileName Condition="$([System.String]::Copy('$(WebSceneClearScriptNativeRid)').StartsWith('linux-'))">ClearScriptV8.$(WebSceneClearScriptNativeRid).so</WebSceneClearScriptNativeFileName>
    <WebSceneClearScriptNativeFileName Condition="$([System.String]::Copy('$(WebSceneClearScriptNativeRid)').StartsWith('osx-'))">ClearScriptV8.$(WebSceneClearScriptNativeRid).dylib</WebSceneClearScriptNativeFileName>
    <WebSceneClearScriptNativeCacheRoot Condition="'$(WebSceneClearScriptNativeCacheRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\v8-native</WebSceneClearScriptNativeCacheRoot>
    <WebSceneClearScriptNativeCacheCandidate>$(WebSceneClearScriptNativeCacheRoot)\runtimes\$(WebSceneClearScriptNativeRid)\native\$(WebSceneClearScriptNativeFileName)</WebSceneClearScriptNativeCacheCandidate>
    <WebSceneClearScriptNativeOutputCandidate>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\runtimes\$(WebSceneClearScriptNativeRid)\native\$(WebSceneClearScriptNativeFileName)</WebSceneClearScriptNativeOutputCandidate>
    <WebSceneClearScriptNativePath Condition="'$(WebSceneClearScriptNativePath)' == '' and Exists('$(WebSceneClearScriptNativeCacheCandidate)')">$(WebSceneClearScriptNativeCacheCandidate)</WebSceneClearScriptNativePath>
    <WebSceneClearScriptNativePath Condition="'$(WebSceneClearScriptNativePath)' == '' and Exists('$(WebSceneClearScriptNativeOutputCandidate)')">$(WebSceneClearScriptNativeOutputCandidate)</WebSceneClearScriptNativePath>
    <WebSceneClearScriptNativeFromOutput Condition="'$(WebSceneClearScriptNativePath)' == '$(WebSceneClearScriptNativeOutputCandidate)'">true</WebSceneClearScriptNativeFromOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WebScene.Backend.Avalonia\WebScene.Backend.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\JavaScript.Avalonia.ClearScript\JavaScript.Avalonia.ClearScript.csproj" />
    <ProjectReference Include="..\NativeMonacoEditor.Assets\NativeMonacoEditor.Assets.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Scripts\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NativeMonacoEditor\web\index.html"
             Link="monaco\index.html"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NativeMonacoEditor\web\app.js"
             Link="monaco\app.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NativeMonacoEditor\Assets\monaco.js"
             Link="monaco\Assets\monaco.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NativeMonacoEditor\Assets\monaco.css"
             Link="monaco\Assets\monaco.css"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NativeMonacoEditor\Assets\codicon.ttf"
             Link="monaco\Assets\codicon.ttf"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\..\build\WebSceneClearScriptV8Native.targets" />
</Project>
