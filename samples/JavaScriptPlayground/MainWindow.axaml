<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:native="clr-namespace:HtmlML.Backends.Avalonia.Native;assembly=HtmlML.Backend.Avalonia"
        x:Class="JavaScriptPlayground.MainWindow"
        Width="1200"
        Height="800"
        Title="HtmlML Playground">
  <TabControl x:Name="WorkspaceTabs">
    <TabItem Header="DOM Playground">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#f3f3f3" Padding="12">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Preset:" VerticalAlignment="Center" />
            <ComboBox x:Name="PresetCombo" Width="240">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Apply Preset" Click="OnApplyPresetClick" />
            <Button Content="Reload XAML" Click="OnReloadXamlClick" />
            <Button Content="Run Script" Click="OnRunScriptClick" />
            <CheckBox x:Name="AutoRunCheckBox" Content="Auto run script" IsChecked="True" VerticalAlignment="Center" />
            <ProgressBar x:Name="CompilationProgress"
                         Width="96"
                         Height="6"
                         IsIndeterminate="True"
                         IsVisible="False"
                         VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="160,5,*,5,160">
          <Border Grid.Column="0" BorderBrush="#ddd" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*">
              <Border Background="#f7f7f7" Padding="8" BorderBrush="#ddd" BorderThickness="0,0,0,1">
                <TextBlock Text="XAML" FontWeight="Bold" />
              </Border>
              <Border Grid.Row="1" Margin="8" BorderBrush="#e0e0e0" BorderThickness="1">
                <avaloniaEdit:TextEditor x:Name="XamlEditor"
                               ShowLineNumbers="True"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               FontFamily="Consolas, Courier New, monospace"
                               Foreground="#202020"
                               Background="#ffffff"
                               Padding="8"
                               MinHeight="200" />
              </Border>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="5" Background="#ddd" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

          <Border Grid.Column="2" Background="#ffffff">
            <Grid RowDefinitions="Auto,*">
              <Border Background="#f7f7f7" Padding="8" BorderBrush="#ddd" BorderThickness="0,0,0,1">
                <TextBlock Text="Preview" FontWeight="Bold" />
              </Border>
              <Border Grid.Row="1" Margin="12" Background="#f0f0f0" Padding="12" x:Name="PreviewHost" />
            </Grid>
          </Border>

          <GridSplitter Grid.Column="3" Width="5" Background="#ddd" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

          <Border Grid.Column="4" BorderBrush="#ddd" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*">
              <Border Background="#f7f7f7" Padding="8" BorderBrush="#ddd" BorderThickness="0,0,0,1">
                <TextBlock Text="JavaScript" FontWeight="Bold" />
              </Border>
              <Border Grid.Row="1" Margin="8" BorderBrush="#e0e0e0" BorderThickness="1">
                <avaloniaEdit:TextEditor x:Name="ScriptEditor"
                               ShowLineNumbers="True"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               FontFamily="Consolas, Courier New, monospace"
                               Foreground="#202020"
                               Background="#ffffff"
                               Padding="8"
                               MinHeight="200" />
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem x:Name="NativeMonacoTab" Header="Monaco (native)">
      <Grid RowDefinitions="Auto,*" Background="#1E1E1E">
        <Border Padding="10,8" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="Monaco running on the HtmlML native canvas"
                         Foreground="#F1F1F1"
                         FontWeight="SemiBold" />
              <TextBlock x:Name="NativeMonacoStatus"
                         Text="Select this tab to load"
                         Foreground="#A9A9A9" />
            </StackPanel>
            <Button Grid.Column="1" Content="Reload editor" Click="OnReloadNativeMonacoClick" />
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <native:NativeHtmlMlView x:Name="NativeMonacoHost" />
          <Border x:Name="NativeMonacoFailure"
                  IsVisible="False"
                  Margin="24"
                  Padding="18"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#CC3A1111"
                  CornerRadius="8">
            <TextBlock x:Name="NativeMonacoFailureText"
                       MaxWidth="760"
                       Foreground="White"
                       TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem x:Name="NativeTradingViewTab" Header="TradingView (native)">
      <Grid RowDefinitions="Auto,*" Background="#101216">
        <Border Padding="10,8"
                Background="#181B21"
                BorderBrush="#2A2E37"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="TradingView Terminal on the HtmlML native runtime"
                         Foreground="#F1F1F1"
                         FontWeight="SemiBold" />
              <TextBlock x:Name="NativeTradingViewStatus"
                         Text="Select this tab to load"
                         Foreground="#A9A9A9" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Reload terminal"
                    Click="OnReloadNativeTradingViewClick" />
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <native:NativeHtmlMlView x:Name="NativeTradingViewHost" />
          <Border x:Name="NativeTradingViewFailure"
                  IsVisible="False"
                  Margin="24"
                  Padding="18"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#CC3A1111"
                  CornerRadius="8">
            <TextBlock x:Name="NativeTradingViewFailureText"
                       MaxWidth="760"
                       Foreground="White"
                       TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
