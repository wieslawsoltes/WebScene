<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebScene.Backend.Avalonia\WebScene.Backend.Avalonia.csproj" />
    <ProjectReference Include="..\NativeMonacoEditor.Assets\NativeMonacoEditor.Assets.csproj"
                      ReferenceOutputAssembly="false" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\NativeMonacoEditor\web\index.html"
             Link="index.html"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NativeMonacoEditor\web\app.js"
             Link="app.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NativeMonacoEditor\Assets\monaco.js"
             Link="Assets\monaco.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NativeMonacoEditor\Assets\monaco.css"
             Link="Assets\monaco.css"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\NativeMonacoEditor\Assets\codicon.ttf"
             Link="Assets\codicon.ttf"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
