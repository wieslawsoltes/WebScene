{
  "$schema": "http://json.schemastore.org/template",
  "author": "WebScene",
  "classifications": ["Desktop", "Avalonia", "TypeScript", "React"],
  "identity": "WebScene.Templates.TypeScriptApp",
  "name": "WebScene primarily TypeScript desktop application",
  "shortName": "webscene-typescript",
  "sourceName": "WebSceneTypeScriptApp",
  "preferNameDirectory": true,
  "symbols": {
    "websceneVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.0.11",
      "replaces": "WEBSCENE_PACKAGE_VERSION"
    }
  },
  "primaryOutputs": [{ "path": "WebSceneTypeScriptApp.csproj" }]
}
