{
  "$schema": "http://json.schemastore.org/template",
  "author": "WebScene",
  "classifications": ["Desktop", "Avalonia", "React", "TypeScript"],
  "identity": "WebScene.Templates.ComponentHost",
  "name": "WebScene React component host",
  "shortName": "webscene-component-host",
  "sourceName": "WebSceneComponentHostApp",
  "preferNameDirectory": true,
  "symbols": {
    "websceneVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.0.10",
      "replaces": "WEBSCENE_PACKAGE_VERSION"
    }
  },
  "primaryOutputs": [{ "path": "WebSceneComponentHostApp.csproj" }]
}
