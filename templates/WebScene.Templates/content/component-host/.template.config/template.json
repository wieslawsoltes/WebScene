{
  "$schema": "http://json.schemastore.org/template",
  "author": "WebScene",
  "classifications": ["Desktop", "Avalonia", "React", "TypeScript"],
  "identity": "WebScene.Templates.ComponentHost",
  "name": "WebScene React component host",
  "shortName": "webscene-component-host",
  "sourceName": "WebSceneComponentHost",
  "preferNameDirectory": true,
  "symbols": {
    "websceneVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "11.3.4-alpha.6",
      "replaces": "WEBSCENE_PACKAGE_VERSION"
    }
  },
  "primaryOutputs": [{ "path": "WebSceneComponentHost.csproj" }]
}
