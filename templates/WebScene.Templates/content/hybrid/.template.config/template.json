{
  "$schema": "http://json.schemastore.org/template",
  "author": "WebScene",
  "classifications": ["Desktop", "Avalonia", "Hybrid", "React"],
  "identity": "WebScene.Templates.Hybrid",
  "name": "WebScene hybrid Avalonia and React application",
  "shortName": "webscene-hybrid",
  "sourceName": "WebSceneHybrid",
  "preferNameDirectory": true,
  "symbols": {
    "websceneVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.0.11",
      "replaces": "WEBSCENE_PACKAGE_VERSION"
    }
  },
  "primaryOutputs": [{ "path": "WebSceneHybrid.csproj" }]
}
