<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <HtmlMLInteropApiManifest Condition="'$(HtmlMLInteropApiManifest)' == ''">$(MSBuildThisFileDirectory)GeneratorCapabilities.htmlml-interop-api.json</HtmlMLInteropApiManifest>
    <HtmlMLInteropPolicy Condition="'$(HtmlMLInteropPolicy)' == ''">$(MSBuildThisFileDirectory)GeneratorCapabilities.htmlml-interop-policy.json</HtmlMLInteropPolicy>
    <HtmlMLInteropHarnessId Condition="'$(HtmlMLInteropHarnessId)' == ''">$([System.IO.Path]::GetFileNameWithoutExtension('$(HtmlMLInteropApiManifest)'))-$([System.IO.Path]::GetFileNameWithoutExtension('$(HtmlMLInteropPolicy)'))</HtmlMLInteropHarnessId>
    <IntermediateOutputPath>obj/$(HtmlMLInteropHarnessId)/$(Configuration)/</IntermediateOutputPath>
    <OutputPath>bin/$(HtmlMLInteropHarnessId)/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HtmlML.JavaScript.Interop\HtmlML.JavaScript.Interop.csproj" />
    <ProjectReference Include="..\..\src\HtmlML.JavaScript.Interop.Generator\HtmlML.JavaScript.Interop.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(HtmlMLInteropApiManifest)"
                     Condition="'$(HtmlMLInteropApiManifest)' != ''" />
    <AdditionalFiles Include="$(HtmlMLInteropPolicy)"
                     Condition="'$(HtmlMLInteropPolicy)' != ''" />
  </ItemGroup>
</Project>
