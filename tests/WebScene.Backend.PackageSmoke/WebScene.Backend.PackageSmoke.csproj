<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(WebSceneBackendPackageId)' == ''">
    <ProjectReference Include="..\..\src\WebScene.Backend.Avalonia\WebScene.Backend.Avalonia.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WebSceneBackendPackageId)' != ''">
    <PackageReference Include="$(WebSceneBackendPackageId)"
                      VersionOverride="$(WebSceneBackendPackageVersion)" />
  </ItemGroup>
</Project>
