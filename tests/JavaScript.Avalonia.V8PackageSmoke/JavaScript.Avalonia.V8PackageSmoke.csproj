<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier Condition="'$(WebSceneClearScriptNativeRid)' != ''">$(WebSceneClearScriptNativeRid)</RuntimeIdentifier>
    <WebSceneClearScriptNativePackageId Condition="'$(WebSceneClearScriptNativeRid)' != ''">JavaScript.Avalonia.ClearScript.Native.$(WebSceneClearScriptNativeRid)</WebSceneClearScriptNativePackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" />
    <PackageReference Include="$(WebSceneClearScriptNativePackageId)"
                      VersionOverride="$(WebSceneClearScriptNativePackageVersion)"
                      Condition="'$(WebSceneClearScriptNativePackageId)' != '' and '$(WebSceneClearScriptNativePackageVersion)' != ''" />
  </ItemGroup>

  <Target Name="ValidateWebSceneClearScriptNativePackageSmoke" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WebSceneClearScriptNativeRid)' == '' or '$(WebSceneClearScriptNativePackageVersion)' == ''"
           Text="Pass WebSceneClearScriptNativeRid and WebSceneClearScriptNativePackageVersion to run the V8 native package smoke." />
  </Target>
</Project>
