<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);WEBSCENE_UNO</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../WebScene.Backend.Avalonia.Tests/VariableWebFontTests.cs" Link="VariableWebFontTests.cs" />
    <Compile Include="../WebScene.Backend.Avalonia.Tests/NativeImageResourceTests.cs" Link="NativeImageResourceTests.cs" />
    <None Include="../Fonts/Roboto/*" Link="Fonts/Roboto/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\WebScene.Backend.Uno\WebScene.Backend.Uno.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" VersionOverride="3.119.2" />
    <PackageReference Include="SkiaSharp.HarfBuzz" VersionOverride="3.119.2" />
    <PackageReference Include="Svg.Skia" VersionOverride="5.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
