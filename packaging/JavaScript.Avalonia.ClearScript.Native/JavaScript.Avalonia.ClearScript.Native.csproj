<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId Condition="'$(WebSceneClearScriptNativeRid)' != ''">JavaScript.Avalonia.ClearScript.Native.$(WebSceneClearScriptNativeRid)</PackageId>
    <PackageId Condition="'$(PackageId)' == ''">JavaScript.Avalonia.ClearScript.Native.Template</PackageId>
    <Description>Reviewed patched ClearScript V8 native runtime for WebScene trusted same-origin contexts.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/wieslawsoltes/WebScene</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>avalonia;javascript;v8;clearscript;native</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <WebSceneClearScriptNativeRequired>true</WebSceneClearScriptNativeRequired>
    <WebSceneClearScriptSourceTag>7.5.1</WebSceneClearScriptSourceTag>
    <WebSceneClearScriptV8Revision>14.7.173.23</WebSceneClearScriptV8Revision>
    <WebSceneClearScriptPatchPath>$(MSBuildThisFileDirectory)..\..\third-party\clearscript-patches\ClearScript-7.5.1-SharedContextSecurityToken.patch</WebSceneClearScriptPatchPath>
    <WebSceneClearScriptTypedManagedAbiPatchPath>$(MSBuildThisFileDirectory)..\..\third-party\clearscript-patches\ClearScript-7.5.1-TypedManagedAbi.patch</WebSceneClearScriptTypedManagedAbiPatchPath>
    <WebSceneClearScriptPackageMetadataDir>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/native-package/</WebSceneClearScriptPackageMetadataDir>
    <WebSceneClearScriptNativeHashPath>$(WebSceneClearScriptPackageMetadataDir)clearscript-native.sha256</WebSceneClearScriptNativeHashPath>
    <WebSceneClearScriptPatchHashPath>$(WebSceneClearScriptPackageMetadataDir)clearscript-patch.sha256</WebSceneClearScriptPatchHashPath>
    <WebSceneClearScriptProvenancePath>$(WebSceneClearScriptPackageMetadataDir)clearscript-provenance.txt</WebSceneClearScriptProvenancePath>
    <WebSceneClearScriptRuntimeManifestPath>$(WebSceneClearScriptPackageMetadataDir)clearscript-native-runtime.json</WebSceneClearScriptRuntimeManifestPath>
    <WebSceneClearScriptRuntimePropsPath>$(WebSceneClearScriptPackageMetadataDir)$(PackageId).props</WebSceneClearScriptRuntimePropsPath>
  </PropertyGroup>

  <ItemGroup>
    <_WebSceneReviewedPatch Include="$(WebSceneClearScriptPatchPath)">
      <PackageFileName>ClearScript-7.5.1-SharedContextSecurityToken.patch</PackageFileName>
    </_WebSceneReviewedPatch>
    <_WebSceneReviewedPatch Include="$(WebSceneClearScriptTypedManagedAbiPatchPath)">
      <PackageFileName>ClearScript-7.5.1-TypedManagedAbi.patch</PackageFileName>
    </_WebSceneReviewedPatch>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\..\third-party\clearscript-patches\README.md"
          Pack="true" PackagePath="build\clearscript-patches\README.md" />
    <None Include="$(WebSceneClearScriptPatchPath)"
          Pack="true" PackagePath="build\clearscript-patches\ClearScript-7.5.1-SharedContextSecurityToken.patch" />
    <None Include="$(WebSceneClearScriptTypedManagedAbiPatchPath)"
          Pack="true" PackagePath="build\clearscript-patches\ClearScript-7.5.1-TypedManagedAbi.patch" />
    <None Include="$(WebSceneClearScriptNativePath)"
          Pack="true"
          PackagePath="runtimes\$(WebSceneClearScriptNativeRid)\native\$(WebSceneClearScriptNativeExpectedFileName)"
          Condition="'$(WebSceneClearScriptNativePath)' != ''" />
    <None Include="$(WebSceneClearScriptNativeHashPath)" Pack="true" PackagePath="build\clearscript-native.sha256" />
    <None Include="$(WebSceneClearScriptPatchHashPath)" Pack="true" PackagePath="build\clearscript-patch.sha256" />
    <None Include="$(WebSceneClearScriptProvenancePath)" Pack="true" PackagePath="build\clearscript-provenance.txt" />
    <None Include="$(WebSceneClearScriptRuntimeManifestPath)"
          Pack="true"
          PackagePath="runtimes\$(WebSceneClearScriptNativeRid)\native\clearscript-native-runtime.json" />
    <None Include="$(WebSceneClearScriptRuntimePropsPath)"
          Pack="true"
          PackagePath="buildTransitive\$(PackageId).props" />
    <None Include="JavaScript.Avalonia.ClearScript.Native.targets"
          Pack="true"
          PackagePath="buildTransitive\$(PackageId).targets" />
  </ItemGroup>

  <Target Name="PrepareWebSceneClearScriptNativePackage"
          BeforeTargets="GenerateNuspec"
          DependsOnTargets="ValidateWebSceneClearScriptV8Native">
    <MakeDir Directories="$(WebSceneClearScriptPackageMetadataDir)" />
    <GetFileHash Files="$(WebSceneClearScriptNativePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WebSceneNativeHash" />
    </GetFileHash>
    <GetFileHash Files="@(_WebSceneReviewedPatch)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WebSceneReviewedPatchHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(WebSceneClearScriptNativeHashPath)"
                      Lines="%(_WebSceneNativeHash.FileHash)  $(WebSceneClearScriptNativeExpectedFileName)"
                      Overwrite="true" />
    <WriteLinesToFile File="$(WebSceneClearScriptPatchHashPath)"
                      Lines="@(_WebSceneReviewedPatchHash->'%(FileHash)  %(PackageFileName)')"
                      Overwrite="true" />
    <WriteLinesToFile File="$(WebSceneClearScriptProvenancePath)"
                      Lines="ClearScript source tag: $(WebSceneClearScriptSourceTag);V8 revision: $(WebSceneClearScriptV8Revision);RID: $(WebSceneClearScriptNativeRid)"
                      Overwrite="true" />
    <PropertyGroup>
      <WebSceneClearScriptNativeHash>@(_WebSceneNativeHash->'%(FileHash)')</WebSceneClearScriptNativeHash>
    </PropertyGroup>
    <WriteLinesToFile File="$(WebSceneClearScriptRuntimeManifestPath)"
                      Lines="{&quot;schemaVersion&quot;:1,&quot;packageVersion&quot;:&quot;$(PackageVersion)&quot;,&quot;runtimeIdentifier&quot;:&quot;$(WebSceneClearScriptNativeRid)&quot;,&quot;fileName&quot;:&quot;$(WebSceneClearScriptNativeExpectedFileName)&quot;,&quot;sha256&quot;:&quot;$(WebSceneClearScriptNativeHash)&quot;,&quot;clearScriptVersion&quot;:&quot;$(WebSceneClearScriptSourceTag)&quot;,&quot;v8Revision&quot;:&quot;$(WebSceneClearScriptV8Revision)&quot;,&quot;configuration&quot;:&quot;$(Configuration)&quot;}"
                      Overwrite="true" />
    <WriteLinesToFile File="$(WebSceneClearScriptRuntimePropsPath)"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;WebSceneClearScriptPackagedRid&gt;$(WebSceneClearScriptNativeRid)&lt;/WebSceneClearScriptPackagedRid&gt;&lt;WebSceneClearScriptPackagedFileName&gt;$(WebSceneClearScriptNativeExpectedFileName)&lt;/WebSceneClearScriptPackagedFileName&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;"
                      Overwrite="true" />
  </Target>

  <Import Project="..\..\build\WebSceneClearScriptV8Native.targets" />
</Project>
