<Project>
  <PropertyGroup>
    <WebSceneClearScriptPackageRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</WebSceneClearScriptPackageRoot>
    <WebSceneClearScriptPackageAsset>$(WebSceneClearScriptPackageRoot)runtimes\$(WebSceneClearScriptPackagedRid)\native\$(WebSceneClearScriptPackagedFileName)</WebSceneClearScriptPackageAsset>
    <WebSceneClearScriptPackageManifest>$(WebSceneClearScriptPackageRoot)runtimes\$(WebSceneClearScriptPackagedRid)\native\clearscript-native-runtime.json</WebSceneClearScriptPackageManifest>
  </PropertyGroup>

  <ItemGroup Condition="'$(WebSceneClearScriptPackagedRid)' != ''">
    <Content Include="$(WebSceneClearScriptPackageAsset)"
             Link="$(WebSceneClearScriptPackagedFileName)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(WebSceneClearScriptPackageManifest)"
             Link="clearscript-native-runtime.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateWebSceneClearScriptRuntimePackage"
          BeforeTargets="PrepareForBuild"
          Condition="'$(WebSceneClearScriptPackagedRid)' != ''">
    <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != '$(WebSceneClearScriptPackagedRid)'"
           Text="WebScene ClearScript runtime package RID '$(WebSceneClearScriptPackagedRid)' does not match target RuntimeIdentifier '$(RuntimeIdentifier)'." />
    <Error Condition="!Exists('$(WebSceneClearScriptPackageAsset)')"
           Text="WebScene ClearScript runtime package is corrupt; the native asset is missing: $(WebSceneClearScriptPackageAsset)" />
    <Error Condition="!Exists('$(WebSceneClearScriptPackageManifest)')"
           Text="WebScene ClearScript runtime package is corrupt; its manifest is missing: $(WebSceneClearScriptPackageManifest)" />
  </Target>
</Project>
