<Project>
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <Title Condition="'$(Title)' == ''">$(PackageId)</Title>
    <PackageTags Condition="!$([System.String]::Copy(';$(PackageTags);').Contains(';webscene;'))">$(PackageTags);webscene</PackageTags>
    <PackageTags Condition="!$([System.String]::Copy(';$(PackageTags);').Contains(';web-ui;'))">$(PackageTags);web-ui</PackageTags>
    <PackageTags Condition="!$([System.String]::Copy(';$(PackageTags);').Contains(';native-ui;'))">$(PackageTags);native-ui</PackageTags>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">Standardizes WebScene on the native runtime; adds autonomous custom elements, Shadow DOM projection, expanded form and layout compatibility, and Chromium WPT oracle coverage; ships V8 15.3.10 with PartitionAlloc across macOS, Linux, and Windows.</PackageReleaseNotes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(PackageReadmeFile)' == ''">
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <WebSceneUsesSharedPackageReadme>true</WebSceneUsesSharedPackageReadme>
  </PropertyGroup>
  <ItemGroup Condition="'$(WebSceneUsesSharedPackageReadme)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)docs\nuget\README.md"
          Pack="true"
          PackagePath="README.md"
          Condition="Exists('$(MSBuildThisFileDirectory)docs\nuget\README.md')" />
  </ItemGroup>
</Project>
