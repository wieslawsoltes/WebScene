{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HtmlML JavaScript interop policy",
  "type": "object",
  "required": [
    "schemaVersion",
    "api",
    "namespace",
    "bindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "api": {
      "type": "string",
      "minLength": 1
    },
    "apiFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
    },
    "typeMappings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "functionsClassName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "globalProperties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/globalProperty"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adapter"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "function": {
      "type": "object",
      "required": [
        "source",
        "globalName"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "globalName": {
          "type": "string",
          "minLength": 1
        },
        "overload": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "include": {
          "type": "boolean"
        },
        "omitOptionalParameters": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "globalProperty": {
      "type": "object",
      "required": [
        "source",
        "globalName"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "globalName": {
          "type": "string",
          "minLength": 1
        },
        "getterName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "include": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "include": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": [
        "source",
        "name"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "include": {
          "type": "boolean"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          }
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "source",
        "name",
        "methods"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "include": {
          "type": "boolean"
        },
        "constructor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/constructor"
            }
          ]
        },
        "constructors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constructor"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        }
      },
      "additionalProperties": false
    },
    "constructor": {
      "type": "object",
      "required": [
        "globalName"
      ],
      "properties": {
        "globalName": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "overload": {
          "type": "integer",
          "minimum": 0
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "dotnetType"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "dotnetType": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "overload": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "include": {
          "type": "boolean"
        },
        "omitOptionalParameters": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "boolean"
        },
        "getterName": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "setterName": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "write": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
